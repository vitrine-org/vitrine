// Vitrine control panel — Windows 11 Fluent layout: navigation pane on the
// left, pages on the right that cross-fade and slide when you navigate.

import { Button, ComboBox, LineEdit, Palette, ProgressIndicator, ScrollView, SpinBox, Spinner, Switch } from "std-widgets.slint";

export struct InstanceRow {
    id: string,
    name: string,
    detail: string,
    has-settings: bool,
    preview: image,
}

export struct LibraryRow {
    package: string,
    widget: string,
    name: string,
    description: string,
    pack: string,
    size: string,
    preview: image,
    // Position in the results grid (kept while it fades out) and whether it matches.
    slot: int,
    shown: bool,
    // The sizes it comes in ("2×2 · 4×4") and whether it is starred.
    sizes: string,
    favourite: bool,
}

// A section of the gallery: favourites first, then one per pack.
export struct GallerySection {
    id: string,
    name: string,
    initial: string,
    tint: color,
    favourites: bool,
    // Widgets passing the search, and whether the section shows and is open.
    count: int,
    shown: bool,
    expanded: bool,
    first: bool,
    last: bool,
    items: [LibraryRow],
}

// A package filter chip; `initial` and `tint` draw its avatar (empty for "All").
export struct PackChip {
    id: string,
    name: string,
    initial: string,
    tint: color,
    count: int,
}

// state: 0 not installed, 1 installed, 2 update available
export struct StoreRow {
    id: string,
    name: string,
    author: string,
    description: string,
    summary: string,
    official: bool,
    state: int,
    preview: image,
    slot: int,
    shown: bool,
}

export struct StoreWidgetRow {
    name: string,
    description: string,
    size: string,
    interactive: bool,
    online: bool,
    preview: image,
}

export struct PermissionRow {
    glyph: string,
    title: string,
    detail: string,
}

export struct DetailRow {
    label: string,
    value: string,
}

export struct PackageRow {
    id: string,
    name: string,
    detail: string,
}

// kind: 0 switch, 1 integer, 2 text, 3 choice, 4 decimal
export struct SettingRow {
    key: string,
    section: string,
    label: string,
    description: string,
    kind: int,
    bool-value: bool,
    int-value: int,
    min: int,
    max: int,
    step: int,
    text-value: string,
    options: [string],
    selected: int,
    enabled: bool,
    error: string,
}

component Glyph inherits Text {
    font-family: "Segoe Fluent Icons";
    font-size: 16px;
    vertical-alignment: center;
    horizontal-alignment: center;
}

component NavItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> selected;
    // A count shown as an accent pill at the end (0 hides it).
    in property <int> badge;
    callback clicked();
    height: 36px;
    border-radius: 4px;
    background: selected ? Palette.alternate-background.mix(Palette.foreground, 0.92)
        : touch.pressed ? Palette.alternate-background.mix(Palette.foreground, 0.97)
        : touch.has-hover ? Palette.alternate-background.mix(Palette.foreground, 0.95) : transparent;
    animate background { duration: 120ms; }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    Rectangle {
        x: 0;
        width: 3px;
        height: root.selected ? 16px : 0px;
        y: (parent.height - self.height) / 2;
        border-radius: 1.5px;
        background: Palette.accent-background;
        animate height { duration: 180ms; easing: ease-out; }
    }
    HorizontalLayout {
        padding-left: 14px;
        spacing: 12px;
        Glyph { text: root.glyph; width: 20px; }
        Text {
            text: root.label;
            vertical-alignment: center;
            font-size: 14px;
        }
        Rectangle { }
        VerticalLayout {
            alignment: center;
            padding-right: 10px;
            Rectangle {
                height: 18px;
                width: Math.max(18px, badge-text.preferred-width + 10px);
                border-radius: 9px;
                background: Palette.accent-background;
                opacity: root.badge > 0 ? 1 : 0;
                transform-scale-x: root.badge > 0 ? 100% : 60%;
                transform-scale-y: root.badge > 0 ? 100% : 60%;
                animate opacity { duration: 180ms; }
                animate transform-scale-x, transform-scale-y { duration: 260ms; easing: cubic-bezier(0.2, 1.4, 0.4, 1); }
                badge-text := Text {
                    text: root.badge;
                    color: Palette.accent-foreground;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component Card inherits Rectangle {
    border-radius: 8px;
    background: Palette.control-background;
    border-width: 1px;
    border-color: Palette.border.with-alpha(0.35);
}

component PageTitle inherits Text {
    font-size: 28px;
    font-weight: 600;
}

component Caption inherits Text {
    font-size: 12px;
    color: Palette.foreground.with-alpha(0.65);
    wrap: word-wrap;
}

component IconButton inherits Rectangle {
    in property <string> glyph;
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: 4px;
    background: touch.pressed ? Palette.alternate-background.mix(Palette.foreground, 0.88)
        : touch.has-hover ? Palette.alternate-background.mix(Palette.foreground, 0.92) : transparent;
    animate background { duration: 120ms; }
    Glyph { text: root.glyph; }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A page fades and slides in when it becomes active.
component Page inherits Rectangle {
    in property <bool> active;
    opacity: active ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity { duration: 200ms; easing: ease-out; }
    Rectangle {
        y: root.active ? 0px : 12px;
        animate y { duration: 260ms; easing: cubic-bezier(0.1, 0.9, 0.2, 1); }
        height: parent.height;
        ScrollView {
            content := VerticalLayout {
                padding: 36px;
                padding-top: 28px;
                spacing: 8px;
                alignment: start;
                @children
            }
        }
    }
}

// The tile every preview sits on: one neutral solid colour, a dark well in
// both themes (like macOS), so theme packs' light-on-transparent previews read.
component PreviewWell inherits Rectangle {
    in property <image> source;
    in property <length> inset: 8px;
    property <bool> dark: Palette.foreground == #ffffff;
    border-radius: 6px;
    background: root.dark ? #1f1f1f : #2b2b2b;
    border-width: 1px;
    border-color: root.dark ? #ffffff0d : #00000014;
    clip: true;
    Image {
        source: root.source;
        image-fit: contain;
        width: parent.width - 2 * root.inset;
        height: parent.height - 2 * root.inset;
        x: root.inset;
        y: root.inset;
    }
    @children
}

// Cards of a results grid fade and scale in when they appear, glide to their
// new place when the results change, and fade out when filtered away.
component ResultCard inherits Rectangle {
    in property <bool> shown: true;
    out property <bool> hovered: touch.has-hover;
    callback clicked();
    property <bool> appeared;
    property <bool> on: self.appeared && root.shown;
    init => {
        self.appeared = true;
    }
    border-radius: 10px;
    background: touch.pressed ? Palette.control-background.mix(Palette.foreground, 0.9)
        : touch.has-hover ? Palette.control-background.mix(Palette.foreground, 0.95) : Palette.control-background;
    border-width: 1px;
    border-color: touch.has-hover ? Palette.accent-background.with-alpha(0.7) : Palette.border.with-alpha(0.35);
    drop-shadow-blur: touch.has-hover ? 16px : 0px;
    drop-shadow-offset-y: touch.has-hover ? 4px : 0px;
    drop-shadow-color: #00000040;
    opacity: root.on ? 1 : 0;
    visible: self.opacity > 0.01;
    transform-scale-x: root.on ? (touch.pressed ? 98.5% : 100%) : 94%;
    transform-scale-y: self.transform-scale-x;
    animate background, border-color { duration: 140ms; }
    animate drop-shadow-blur, drop-shadow-offset-y { duration: 200ms; easing: ease-out; }
    animate opacity { duration: 200ms; easing: ease-out; }
    animate transform-scale-x { duration: 280ms; easing: cubic-bezier(0.1, 0.9, 0.2, 1); }
    touch := TouchArea {
        enabled: root.shown;
        clicked => { root.clicked(); }
    }
    @children
}

// The favourite star: shown on hover, and always once set. It pops when toggled.
component StarButton inherits Rectangle {
    in property <bool> on;
    in property <bool> reveal;
    // On a preview well (dark) or on the card itself.
    in property <bool> on-well: true;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: root.on-well
        ? (touch.pressed ? #000000a6 : touch.has-hover ? #0000008c : #00000059)
        : (touch.pressed ? Palette.control-background.mix(Palette.foreground, 0.86)
            : touch.has-hover ? Palette.control-background.mix(Palette.foreground, 0.92) : Palette.control-background.with-alpha(0));
    opacity: root.on || root.reveal || touch.has-hover ? 1 : 0;
    animate opacity { duration: 140ms; easing: ease-out; }
    animate background { duration: 120ms; }
    Glyph {
        text: root.on ? "\u{E735}" : "\u{E734}";
        font-size: 14px;
        color: root.on ? #ffc83d : root.on-well ? #ffffff : Palette.foreground.with-alpha(0.75);
        transform-scale-x: touch.pressed ? 80% : root.on ? 100% : 92%;
        transform-scale-y: self.transform-scale-x;
        animate transform-scale-x { duration: 260ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
        animate color { duration: 160ms; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A widget of the gallery: a preview card in the grid, a compact row in the list.
component GalleryCard inherits ResultCard {
    in property <LibraryRow> item;
    in property <bool> list;
    callback star();
    shown: root.item.shown;
    if !root.list: VerticalLayout {
        padding: 8px;
        spacing: 6px;
        PreviewWell {
            source: root.item.preview;
            vertical-stretch: 1;
            StarButton {
                x: parent.width - self.width - 6px;
                y: 6px;
                on: root.item.favourite;
                reveal: root.hovered;
                clicked => { root.star(); }
            }
        }
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            spacing: 6px;
            VerticalLayout {
                Text {
                    text: root.item.name;
                    font-weight: 600;
                    overflow: elide;
                }
                Caption {
                    text: root.item.pack;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }
            Caption {
                text: root.item.size;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
    }
    if root.list: HorizontalLayout {
        padding: 6px;
        padding-right: 8px;
        spacing: 14px;
        PreviewWell {
            width: 92px;
            inset: 4px;
            source: root.item.preview;
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.item.name;
                font-weight: 600;
                overflow: elide;
            }
            Caption {
                text: root.item.description != "" ? root.item.pack + " · " + root.item.description : root.item.pack;
                wrap: no-wrap;
                overflow: elide;
            }
        }
        Caption {
            text: root.item.sizes;
            vertical-alignment: center;
            horizontal-alignment: right;
            wrap: no-wrap;
            horizontal-stretch: 0;
        }
        VerticalLayout {
            alignment: center;
            StarButton {
                on: root.item.favourite;
                reveal: root.hovered;
                on-well: false;
                clicked => { root.star(); }
            }
        }
    }
}

// A collapsible section of the gallery: a header (avatar, name, count,
// chevron) and its cards, which open and close with an animated height.
// Right-click a pack's header (or use its "…" button) to move or hide it.
component GallerySectionView inherits Rectangle {
    in property <GallerySection> section;
    in property <bool> list;
    callback toggle();
    callback open(string, string);
    callback star(string, string);
    callback move(int);
    callback hide();
    property <length> gap: 12px;
    property <int> cols: Math.max(1, Math.floor((self.width + self.gap) / (220px + self.gap)));
    property <length> card-w: (self.width - (self.cols - 1) * self.gap) / self.cols;
    property <length> card-h: self.card-w * 0.78;
    property <length> row-h: 64px;
    property <length> head-h: 48px;
    property <length> body-h: Math.max(0px, root.list
        ? root.section.count * (root.row-h + 6px) - 6px
        : Math.ceil(root.section.count / root.cols) * (root.card-h + root.gap) - root.gap);
    property <bool> is-open: root.section.expanded && root.section.count > 0;
    height: !root.section.shown ? 0px : root.is-open ? root.head-h + root.body-h + 22px : root.head-h + 2px;
    animate height { duration: 320ms; easing: cubic-bezier(0.1, 0.9, 0.2, 1); }
    opacity: root.section.shown ? 1 : 0;
    animate opacity { duration: 180ms; easing: ease-out; }
    visible: self.opacity > 0.01;
    clip: true;

    menu := ContextMenuArea {
        enabled: !root.section.favourites;
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.head-h;
        Menu {
            MenuItem {
                title: @tr("Move up");
                enabled: !root.section.first;
                activated => { root.move(-1); }
            }
            MenuItem {
                title: @tr("Move down");
                enabled: !root.section.last;
                activated => { root.move(1); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Hide this pack");
                activated => { root.hide(); }
            }
        }
        header := Rectangle {
            y: 4px;
            height: root.head-h - 8px;
            border-radius: 6px;
            background: htouch.pressed ? Palette.background.mix(Palette.foreground, 0.92)
                : htouch.has-hover ? Palette.background.mix(Palette.foreground, 0.96) : Palette.background.with-alpha(0);
            animate background { duration: 120ms; }
            htouch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle(); }
                // The header takes the pointer, so it opens the menu itself.
                pointer-event(e) => {
                    if (!root.section.favourites && e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                        menu.show({ x: self.mouse-x, y: self.mouse-y + 4px });
                    }
                }
            }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 4px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: root.section.favourites ? #ffc83d : root.section.tint;
                        if root.section.favourites: Glyph {
                            text: "\u{E735}";
                            font-size: 14px;
                            color: #3d2c00;
                        }
                        if !root.section.favourites: Text {
                            text: root.section.initial;
                            color: #ffffff;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Text {
                    text: root.section.name;
                    font-size: 16px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 0;
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 20px;
                        width: count.preferred-width + 14px;
                        border-radius: 10px;
                        background: Palette.foreground.with-alpha(0.07);
                        count := Text {
                            text: root.section.count;
                            font-size: 12px;
                            color: Palette.foreground.with-alpha(0.7);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { }
                if !root.section.favourites: VerticalLayout {
                    alignment: center;
                    IconButton {
                        glyph: "\u{E712}";
                        width: 32px;
                        height: 32px;
                        clicked => { menu.show({ x: header.width - 168px, y: root.head-h - 4px }); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        Glyph {
                            text: "\u{E70D}";
                            font-size: 12px;
                            color: Palette.foreground.with-alpha(0.75);
                            transform-rotation: root.is-open ? 0deg : -90deg;
                            animate transform-rotation { duration: 260ms; easing: cubic-bezier(0.1, 0.9, 0.2, 1); }
                        }
                    }
                }
            }
        }
    }
    body := Rectangle {
        x: 0px;
        y: root.head-h + 6px;
        width: 100%;
        height: root.body-h;
        opacity: root.is-open ? 1 : 0;
        animate opacity { duration: 220ms; easing: ease-out; }
        for item in root.section.items: GalleryCard {
            item: item;
            list: root.list;
            x: root.list ? 0px : Math.mod(item.slot, root.cols) * (root.card-w + root.gap);
            y: root.list ? item.slot * (root.row-h + 6px) : Math.floor(item.slot / root.cols) * (root.card-h + root.gap);
            width: root.list ? body.width : root.card-w;
            height: root.list ? root.row-h : root.card-h;
            animate x, y, width, height { duration: 340ms; easing: cubic-bezier(0.1, 0.9, 0.2, 1); }
            clicked => { root.open(item.package, item.widget); }
            star => { root.star(item.package, item.widget); }
        }
    }
}

// A small text button with an icon, for the gallery's view options.
component ToolChip inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    callback clicked();
    height: 28px;
    width: row.preferred-width;
    border-radius: 4px;
    background: touch.pressed ? Palette.background.mix(Palette.foreground, 0.9)
        : touch.has-hover ? Palette.background.mix(Palette.foreground, 0.95) : Palette.background.with-alpha(0);
    animate background { duration: 120ms; }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 7px;
        Glyph {
            text: root.glyph;
            font-size: 13px;
            color: Palette.foreground.with-alpha(0.8);
        }
        Text {
            text: root.text;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// Grid / list switch: two icon segments with a sliding indicator.
component ViewToggle inherits Rectangle {
    in-out property <bool> list;
    callback changed(bool);
    width: 72px;
    height: 32px;
    border-radius: 6px;
    background: Palette.control-background;
    border-width: 1px;
    border-color: Palette.border.with-alpha(0.5);
    Rectangle {
        x: root.list ? 37px : 3px;
        animate x { duration: 260ms; easing: cubic-bezier(0.1, 0.9, 0.2, 1); }
        y: 3px;
        width: 32px;
        height: 26px;
        border-radius: 4px;
        background: Palette.accent-background.with-alpha(0.18);
        Rectangle {
            y: parent.height - 3px;
            x: 10px;
            width: 12px;
            height: 3px;
            border-radius: 1.5px;
            background: Palette.accent-background;
        }
    }
    for glyph[i] in ["\u{ECA5}", "\u{E8FD}"]: Rectangle {
        x: 3px + i * 34px;
        y: 3px;
        width: 32px;
        height: 26px;
        Glyph {
            text: glyph;
            font-size: 14px;
            color: (i == 1) == root.list ? Palette.foreground : Palette.foreground.with-alpha(0.6);
        }
        TouchArea {
            clicked => {
                root.list = i == 1;
                root.changed(root.list);
            }
        }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 32px;
    width: label.preferred-width + 28px;
    border-radius: 16px;
    background: selected ? Palette.accent-background
        : touch.has-hover ? Palette.control-background.mix(Palette.foreground, 0.92) : Palette.control-background;
    border-width: 1px;
    border-color: selected ? Palette.accent-background : Palette.border.with-alpha(0.5);
    animate background { duration: 140ms; }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    label := Text {
        text: root.text;
        color: root.selected ? Palette.accent-foreground : Palette.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A search field: LineEdit with a magnifier that turns into a clear button.
component SearchBox inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    callback edited(string);
    public function focus-input() {
        input.focus();
        input.select-all();
    }
    height: 34px;
    input := LineEdit {
        width: 100%;
        height: 100%;
        placeholder-text: root.placeholder;
        text <=> root.text;
        edited(t) => { root.edited(t); }
    }
    Rectangle {
        width: 28px;
        height: 26px;
        x: parent.width - self.width - 4px;
        y: (parent.height - self.height) / 2;
        border-radius: 4px;
        background: root.text != "" && clear.has-hover ? Palette.alternate-background.mix(Palette.foreground, 0.9) : Palette.control-background.with-alpha(0);
        animate background { duration: 120ms; }
        Glyph {
            text: "\u{E721}";
            font-size: 14px;
            color: Palette.foreground.with-alpha(0.6);
            opacity: root.text == "" ? 1 : 0;
            transform-rotation: root.text == "" ? 0deg : -90deg;
            animate opacity, transform-rotation { duration: 160ms; easing: ease-out; }
        }
        Glyph {
            text: "\u{E711}";
            font-size: 11px;
            color: Palette.foreground.with-alpha(0.8);
            opacity: root.text == "" ? 0 : 1;
            transform-rotation: root.text == "" ? 90deg : 0deg;
            animate opacity, transform-rotation { duration: 160ms; easing: ease-out; }
        }
        clear := TouchArea {
            enabled: root.text != "";
            mouse-cursor: root.text != "" ? pointer : default;
            clicked => {
                root.text = "";
                root.edited("");
                input.focus();
            }
        }
    }
}

// A package chip: avatar initial, name and how many widgets match.
component PackChipView inherits Rectangle {
    in property <PackChip> chip;
    in property <bool> selected;
    callback clicked();
    height: 32px;
    width: row.preferred-width;
    border-radius: 16px;
    background: root.selected ? Palette.accent-background
        : touch.pressed ? Palette.control-background.mix(Palette.foreground, 0.88)
        : touch.has-hover ? Palette.control-background.mix(Palette.foreground, 0.93) : Palette.control-background;
    border-width: 1px;
    border-color: root.selected ? Palette.accent-background : Palette.border.with-alpha(0.5);
    opacity: root.chip.count == 0 && !root.selected ? 0.55 : 1;
    animate background, border-color { duration: 160ms; }
    animate opacity { duration: 180ms; }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    row := HorizontalLayout {
        padding-left: root.chip.initial == "" ? 14px : 5px;
        padding-right: 12px;
        spacing: 8px;
        if root.chip.initial != "": VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: root.chip.tint;
                Text {
                    text: root.chip.initial;
                    color: #ffffff;
                    font-size: 11px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.chip.name;
            vertical-alignment: center;
            color: root.selected ? Palette.accent-foreground : Palette.foreground;
        }
        Text {
            text: root.chip.count;
            font-size: 12px;
            vertical-alignment: center;
            color: root.selected ? Palette.accent-foreground.with-alpha(0.75) : Palette.foreground.with-alpha(0.55);
        }
    }
}

// A small toggle chip for facets (size, interactive, online).
component FacetChip inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <bool> selected;
    callback clicked();
    height: 28px;
    width: row.preferred-width;
    border-radius: 14px;
    background: root.selected ? Palette.accent-background.with-alpha(0.16)
        : touch.pressed ? Palette.control-background.mix(Palette.foreground, 0.88)
        : touch.has-hover ? Palette.control-background.mix(Palette.foreground, 0.94) : Palette.control-background.with-alpha(0);
    border-width: 1px;
    border-color: root.selected ? Palette.accent-background : Palette.border.with-alpha(0.45);
    animate background, border-color { duration: 160ms; }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    row := HorizontalLayout {
        padding-left: 11px;
        padding-right: 12px;
        spacing: 6px;
        if root.glyph != "" || root.selected: Glyph {
            text: root.selected ? "\u{E73E}" : root.glyph;
            font-size: 12px;
            color: root.selected ? Palette.accent-background : Palette.foreground.with-alpha(0.75);
        }
        Text {
            text: root.text;
            font-size: 12px;
            vertical-alignment: center;
            color: Palette.foreground;
        }
    }
}

// "Official", "Installed", "Update available": a compact pill.
component Pill inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    // 0 subtle, 1 accent tint, 2 accent filled
    in property <int> tone;
    height: 20px;
    width: row.preferred-width;
    border-radius: 10px;
    background: root.tone == 2 ? Palette.accent-background
        : root.tone == 1 ? Palette.accent-background.with-alpha(0.14) : Palette.foreground.with-alpha(0.07);
    row := HorizontalLayout {
        padding-left: 7px;
        padding-right: 8px;
        spacing: 4px;
        if root.glyph != "": Glyph {
            text: root.glyph;
            font-size: 10px;
            color: root.tone == 2 ? Palette.accent-foreground : root.tone == 1 ? Palette.accent-background : Palette.foreground.with-alpha(0.75);
        }
        Text {
            text: root.text;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
            color: root.tone == 2 ? Palette.accent-foreground : root.tone == 1 ? Palette.accent-background : Palette.foreground.with-alpha(0.8);
        }
    }
}

// A friendly message in place of an empty list.
component EmptyState inherits Card {
    in property <string> glyph;
    in property <string> title;
    in property <string> caption;
    in property <string> action;
    in property <bool> busy;
    callback activated();
    height: 200px;
    property <bool> appeared;
    init => {
        self.appeared = true;
    }
    opacity: self.appeared ? 1 : 0;
    animate opacity { duration: 240ms; easing: ease-out; }
    VerticalLayout {
        alignment: center;
        spacing: 6px;
        if root.busy: HorizontalLayout {
            alignment: center;
            padding-bottom: 6px;
            Spinner {
                indeterminate: true;
                width: 32px;
                height: 32px;
            }
        }
        if !root.busy && root.glyph != "": Glyph {
            text: root.glyph;
            font-size: 32px;
            height: 44px;
            color: Palette.foreground.with-alpha(0.45);
        }
        Text {
            text: root.title;
            font-size: 16px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        if root.caption != "": Caption {
            text: root.caption;
            horizontal-alignment: center;
        }
        if root.action != "": HorizontalLayout {
            alignment: center;
            padding-top: 8px;
            Button {
                text: root.action;
                clicked => { root.activated(); }
            }
        }
    }
}

component StoreCard inherits ResultCard {
    in property <StoreRow> item;
    shown: root.item.shown;
    VerticalLayout {
        padding: 8px;
        spacing: 4px;
        PreviewWell {
            source: root.item.preview;
            vertical-stretch: 1;
        }
        VerticalLayout {
            padding-left: 6px;
            padding-right: 6px;
            padding-top: 4px;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.item.name;
                    font-size: 15px;
                    font-weight: 600;
                    overflow: elide;
                    horizontal-stretch: 0;
                }
                if root.item.official: VerticalLayout {
                    alignment: center;
                    Pill {
                        text: @tr("Official");
                        glyph: "\u{E930}";
                        tone: 1;
                    }
                }
                Rectangle { }
                if root.item.state != 0: VerticalLayout {
                    alignment: center;
                    Pill {
                        text: root.item.state == 2 ? @tr("Update available") : @tr("Installed");
                        glyph: root.item.state == 2 ? "\u{E896}" : "\u{E73E}";
                        tone: root.item.state == 2 ? 2 : 0;
                    }
                }
            }
            Caption {
                text: root.item.author;
                wrap: no-wrap;
                overflow: elide;
            }
            Text {
                text: root.item.description;
                font-size: 13px;
                wrap: word-wrap;
                overflow: elide;
                height: 36px;
                color: Palette.foreground.with-alpha(0.85);
            }
            Caption {
                text: root.item.summary;
                wrap: no-wrap;
                overflow: elide;
            }
        }
    }
}

component SectionTitle inherits Text {
    font-size: 16px;
    font-weight: 600;
}

export component PanelWindow inherits Window {
    title: "Vitrine";
    icon: @image-url("../../../assets/icon/png/vitrine-32.png");
    preferred-width: 980px;
    preferred-height: 680px;
    min-width: 760px;
    min-height: 500px;
    // Set from Rust: the Windows UI font for CJK languages.
    in property <string> ui-font: "Segoe UI Variable Text";
    default-font-family: root.ui-font;
    default-font-size: 14px;

    // 0 widgets, 1 gallery, 2 packages, 3 general, 4 instance settings, 5 widget detail,
    // 6 store, 7 store pack
    in-out property <int> page: 0;
    in property <[InstanceRow]> instances;
    // The gallery: favourites, then a section per pack (see GallerySection).
    in property <[GallerySection]> sections;
    // Widgets installed in the packs shown, and the packs hidden from the gallery.
    in property <int> library-total;
    in property <[PackChip]> hidden-packs;
    in-out property <bool> list-view;
    in property <bool> any-expanded;
    callback toggle-section(string);
    callback toggle-favourite(string, string);
    callback move-section(string, int);
    callback hide-section(string);
    callback show-section(string);
    callback set-all-expanded(bool);
    callback set-list-view(bool);
    in property <[PackageRow]> packages;
    in property <[SettingRow]> settings;
    in property <string> settings-title;
    in property <string> settings-subtitle;
    in property <image> settings-preview;
    in property <bool> settings-preview-busy;
    in property <string> version;
    in property <string> status;
    in-out property <bool> autostart;
    in-out property <bool> slow-on-battery;
    in-out property <string> hotkey;
    in property <string> hotkey-error;
    // "System" first, then each language in its own name.
    in property <[string]> languages;
    in-out property <int> language-index;

    in property <LibraryRow> detail;
    in property <image> detail-preview;
    in property <bool> detail-busy;
    in property <[string]> detail-sizes;
    in-out property <int> detail-size: 0;

    callback remove-instance(string);
    callback open-settings(string);
    callback add-widget(string, string);
    callback open-detail(string, string);
    callback choose-size(int);
    callback add-detail();
    callback place-detail();
    callback uninstall(string);
    callback install-file();
    callback set-bool(string, bool);
    callback set-int(string, int);
    callback set-text(string, string);
    callback set-choice(string, int);
    callback reset-settings();
    callback set-autostart(bool);
    callback set-slow-on-battery(bool);
    callback set-hotkey(string);
    callback set-language(int);
    callback open-folder();
    callback edit-layout();

    // Gallery search and filters; Rust recomputes the results on filter-changed.
    in-out property <string> gallery-query;
    in property <[PackChip]> pack-chips;
    in-out property <int> pack-index: 0;
    // 0 any, 1 small, 2 medium, 3 large
    in-out property <int> size-filter: 0;
    in-out property <bool> only-interactive;
    in-out property <bool> only-online;
    in property <int> result-count;
    in property <string> result-text;
    property <bool> filtered: root.gallery-query != "" || root.pack-index != 0 || root.size-filter != 0
        || root.only-interactive || root.only-online;
    callback filter-changed();
    function clear-filters() {
        root.gallery-query = "";
        root.pack-index = 0;
        root.size-filter = 0;
        root.only-interactive = false;
        root.only-online = false;
        root.filter-changed();
    }
    function toggle-size(size: int) {
        root.size-filter = root.size-filter == size ? 0 : size;
        root.filter-changed();
    }

    // Store: 0 loading, 1 ready, 2 offline (and nothing cached).
    in property <int> store-state;
    // Showing the saved catalogue because the Store can't be reached.
    in property <bool> store-stale;
    in property <[StoreRow]> store-packs;
    in property <int> store-count;
    in property <string> store-count-text;
    in-out property <string> store-query;
    in property <[PackChip]> store-tags;
    in-out property <int> store-tag;
    in property <int> store-updates;
    in property <StoreRow> store-detail;
    in property <string> store-detail-meta;
    in property <string> store-detail-description;
    in property <[StoreWidgetRow]> store-detail-widgets;
    in property <[PermissionRow]> store-detail-permissions;
    in property <[DetailRow]> store-detail-facts;
    // The install button's text; empty when the latest version is installed.
    in property <string> store-action;
    in property <string> store-note;
    in property <bool> store-busy;
    in property <float> store-progress;
    in property <string> store-progress-text;
    in property <string> store-error;
    callback store-open();
    callback store-retry();
    callback store-filter-changed();
    callback store-open-pack(string);
    callback store-install();
    callback store-open-repo();
    function open-store() {
        root.page = 6;
        root.store-open();
    }
    function clear-store-filters() {
        root.store-query = "";
        root.store-tag = 0;
        root.store-filter-changed();
    }

    // 0 follows Windows, 1 light, 2 dark (the VITRINE_THEME environment variable).
    in property <int> theme;
    changed theme => {
        Palette.color-scheme = root.theme == 1 ? ColorScheme.light : root.theme == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }
    init => {
        keys.focus();
    }

    // Ctrl+F searches the current list; Esc clears the search.
    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                if (root.page == 6 || root.page == 7) {
                    root.page = 6;
                    store-search.focus-input();
                } else {
                    root.page = 1;
                    gallery-search.focus-input();
                }
                return accept;
            }
            if (event.text == Key.Escape) {
                if ((root.page == 1 || root.page == 5) && root.filtered) {
                    root.clear-filters();
                    return accept;
                }
                if (root.page == 6 && (root.store-query != "" || root.store-tag != 0)) {
                    root.clear-store-filters();
                    return accept;
                }
                if (root.page == 5 || root.page == 4 || root.page == 7) {
                    root.page = root.page == 5 ? 1 : root.page == 7 ? 6 : 0;
                    return accept;
                }
            }
            reject
        }
        HorizontalLayout {
            // Navigation pane.
            Rectangle {
                width: 264px;
                background: Palette.alternate-background;
                VerticalLayout {
                    padding: 8px;
                    padding-top: 16px;
                    spacing: 4px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-bottom: 18px;
                        spacing: 10px;
                        Image {
                            source: @image-url("../../../assets/icon/png/vitrine-32.png");
                            width: 24px;
                            height: 24px;
                        }
                        Text {
                            text: "Vitrine";
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    NavItem {
                        glyph: "\u{E8A9}";
                        label: @tr("My widgets");
                        selected: root.page == 0 || root.page == 4;
                        clicked => { root.page = 0; }
                    }
                    NavItem {
                        glyph: "\u{E710}";
                        label: @tr("Add widgets");
                        selected: root.page == 1 || root.page == 5;
                        clicked => { root.page = 1; }
                    }
                    NavItem {
                        glyph: "\u{E719}";
                        label: @tr("Store");
                        selected: root.page == 6 || root.page == 7;
                        badge: root.store-updates;
                        clicked => { root.open-store(); }
                    }
                    NavItem {
                        glyph: "\u{E7B8}";
                        label: @tr("Packages");
                        selected: root.page == 2;
                        clicked => { root.page = 2; }
                    }
                    NavItem {
                        glyph: "\u{E713}";
                        label: @tr("General");
                        selected: root.page == 3;
                        clicked => { root.page = 3; }
                    }
                    Rectangle { }
                    Caption {
                        text: root.status;
                        x: 12px;
                        width: parent.width - 24px;
                        opacity: root.status == "" ? 0 : 1;
                        animate opacity { duration: 200ms; }
                    }
                    Caption {
                        text: @tr("Version {}", root.version);
                        x: 12px;
                    }
                }
            }

            // Pages, stacked; the active one fades in.
            Rectangle {
                background: Palette.background;

                Page {
                    active: root.page == 0;
                    HorizontalLayout {
                        PageTitle { text: @tr("My widgets"); }
                        Rectangle { }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: @tr("Edit layout");
                                clicked => { root.edit-layout(); }
                            }
                        }
                    }
                    Caption {
                        text: @tr("The widgets on your desktop. Arrange them in Edit layout (Ctrl+Alt+V); your windows step aside while you do.");
                    }
                    Rectangle { height: 8px; }
                    if root.instances.length == 0: Card {
                        height: 120px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 10px;
                            Caption {
                                text: @tr("No widgets yet.");
                                horizontal-alignment: center;
                            }
                            HorizontalLayout {
                                alignment: center;
                                Button {
                                    text: @tr("Browse widgets");
                                    primary: true;
                                    clicked => { root.page = 1; }
                                }
                            }
                        }
                    }
                    for item in root.instances: Card {
                        height: 76px;
                        HorizontalLayout {
                            padding: 8px;
                            padding-right: 12px;
                            spacing: 14px;
                            PreviewWell {
                                width: 104px;
                                source: item.preview;
                            }
                            VerticalLayout {
                                alignment: center;
                                Text { text: item.name; font-weight: 600; }
                                Caption { text: item.detail; }
                            }
                            Rectangle { }
                            if item.has-settings: VerticalLayout {
                                alignment: center;
                                Button {
                                    text: @tr("Settings");
                                    clicked => { root.open-settings(item.id); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Button {
                                    text: @tr("Remove");
                                    clicked => { root.remove-instance(item.id); }
                                }
                            }
                        }
                    }
                }

                Page {
                    active: root.page == 1;
                    HorizontalLayout {
                        PageTitle { text: @tr("Add widgets"); }
                        Rectangle { }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: @tr("Get more widgets");
                                clicked => { root.open-store(); }
                            }
                        }
                    }
                    Caption { text: @tr("Choose a widget to preview it, pick a size and add it to your desktop."); }
                    Rectangle { height: 8px; }
                    HorizontalLayout {
                        spacing: 16px;
                        gallery-search := SearchBox {
                            placeholder: @tr("Search widgets");
                            text <=> root.gallery-query;
                            edited => { root.filter-changed(); }
                        }
                        Caption {
                            text: root.result-text;
                            vertical-alignment: center;
                            wrap: no-wrap;
                            horizontal-stretch: 0;
                        }
                        if root.hidden-packs.length > 0: VerticalLayout {
                            alignment: center;
                            hidden-menu := ContextMenuArea {
                                width: hidden-chip.width;
                                height: hidden-chip.height;
                                Menu {
                                    for p in root.hidden-packs: MenuItem {
                                        title: p.name;
                                        activated => { root.show-section(p.id); }
                                    }
                                }
                                hidden-chip := ToolChip {
                                    glyph: "\u{ED1A}";
                                    text: @tr("Hidden packs") + " (" + root.hidden-packs.length + ")";
                                    clicked => { hidden-menu.show({ x: 0px, y: self.height + 2px }); }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            ToolChip {
                                glyph: root.any-expanded ? "\u{E70E}" : "\u{E70D}";
                                text: root.any-expanded ? @tr("Collapse all") : @tr("Expand all");
                                clicked => { root.set-all-expanded(!root.any-expanded); }
                            }
                        }
                        ViewToggle {
                            list <=> root.list-view;
                            changed(v) => { root.set-list-view(v); }
                        }
                    }
                    Flickable {
                        height: 40px;
                        content-width: chips.preferred-width;
                        chips := HorizontalLayout {
                            spacing: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            for chip[i] in root.pack-chips: PackChipView {
                                chip: chip;
                                selected: i == root.pack-index;
                                clicked => {
                                    root.pack-index = i;
                                    root.filter-changed();
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        FacetChip {
                            text: @tr("Small");
                            selected: root.size-filter == 1;
                            clicked => { root.toggle-size(1); }
                        }
                        FacetChip {
                            text: @tr("Medium");
                            selected: root.size-filter == 2;
                            clicked => { root.toggle-size(2); }
                        }
                        FacetChip {
                            text: @tr("Large");
                            selected: root.size-filter == 3;
                            clicked => { root.toggle-size(3); }
                        }
                        Rectangle {
                            width: 1px;
                            background: Palette.border.with-alpha(0.5);
                        }
                        FacetChip {
                            text: @tr("Interactive");
                            glyph: "\u{E7C9}";
                            selected: root.only-interactive;
                            clicked => {
                                root.only-interactive = !root.only-interactive;
                                root.filter-changed();
                            }
                        }
                        FacetChip {
                            text: @tr("Uses the internet");
                            glyph: "\u{E774}";
                            selected: root.only-online;
                            clicked => {
                                root.only-online = !root.only-online;
                                root.filter-changed();
                            }
                        }
                    }
                    Rectangle { height: 2px; }
                    if root.library-total == 0: EmptyState {
                        glyph: "\u{E719}";
                        title: @tr("No widgets installed");
                        caption: @tr("Find widget packs in the Store.");
                        action: @tr("Open the Store");
                        activated => { root.open-store(); }
                    }
                    if root.library-total > 0 && root.result-count == 0: EmptyState {
                        glyph: "\u{E721}";
                        title: @tr("No widgets found");
                        caption: @tr("Try a different search, or clear the filters.");
                        action: @tr("Clear filters");
                        activated => { root.clear-filters(); }
                    }
                    VerticalLayout {
                        spacing: 0px;
                        for sec in root.sections: GallerySectionView {
                            section: sec;
                            list: root.list-view;
                            toggle => { root.toggle-section(sec.id); }
                            open(p, w) => { root.open-detail(p, w); }
                            star(p, w) => { root.toggle-favourite(p, w); }
                            move(d) => { root.move-section(sec.id, d); }
                            hide => { root.hide-section(sec.id); }
                        }
                    }
                }

                Page {
                    active: root.page == 2;
                    HorizontalLayout {
                        PageTitle { text: @tr("Packages"); }
                        Rectangle { }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: @tr("Install package…");
                                primary: true;
                                clicked => { root.install-file(); }
                            }
                        }
                    }
                    Caption {
                        text: @tr("A package (.vitrine) contains one or more widgets. Double-click a .vitrine file to install it.");
                    }
                    Rectangle { height: 8px; }
                    for item in root.packages: Card {
                        height: 64px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 12px;
                            VerticalLayout {
                                alignment: center;
                                Text { text: item.name; font-weight: 600; }
                                Caption { text: item.detail; }
                            }
                            Rectangle { }
                            VerticalLayout {
                                alignment: center;
                                Button {
                                    text: @tr("Uninstall");
                                    clicked => { root.uninstall(item.id); }
                                }
                            }
                        }
                    }
                }

                Page {
                    active: root.page == 3;
                    PageTitle { text: @tr("General"); }
                    Rectangle { height: 8px; }
                    Card {
                        height: 68px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            VerticalLayout {
                                alignment: center;
                                Text { text: @tr("Start with Windows"); }
                                Caption { text: @tr("Show your widgets when you sign in."); }
                            }
                            Rectangle { }
                            Switch {
                                checked <=> root.autostart;
                                toggled => { root.set-autostart(self.checked); }
                            }
                        }
                    }
                    Card {
                        height: 68px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            VerticalLayout {
                                alignment: center;
                                Text { text: @tr("Save battery"); }
                                Caption { text: @tr("Update system widgets less often on battery power."); }
                            }
                            Rectangle { }
                            Switch {
                                checked <=> root.slow-on-battery;
                                toggled => { root.set-slow-on-battery(self.checked); }
                            }
                        }
                    }
                    Card {
                        height: root.hotkey-error == "" ? 68px : 88px;
                        animate height { duration: 160ms; }
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Text { text: @tr("Edit layout shortcut"); }
                                Caption { text: @tr("For example Ctrl+Alt+V. Takes effect the next time Vitrine starts."); }
                                if root.hotkey-error != "": Text {
                                    text: root.hotkey-error;
                                    color: #e81123;
                                    font-size: 12px;
                                }
                            }
                            Rectangle { }
                            VerticalLayout {
                                alignment: center;
                                LineEdit {
                                    width: 160px;
                                    text <=> root.hotkey;
                                    accepted(t) => { root.set-hotkey(t); }
                                    edited(t) => { root.set-hotkey(t); }
                                }
                            }
                        }
                    }
                    Card {
                        height: 68px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Text { text: @tr("Language"); }
                                Caption { text: @tr("Used by Vitrine and by widgets that support it."); }
                            }
                            Rectangle { }
                            VerticalLayout {
                                alignment: center;
                                ComboBox {
                                    width: 220px;
                                    model: root.languages;
                                    current-index <=> root.language-index;
                                    selected => { root.set-language(self.current-index); }
                                }
                            }
                        }
                    }
                    Card {
                        height: 68px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            VerticalLayout {
                                alignment: center;
                                Text { text: @tr("Data folder"); }
                                Caption { text: @tr("Layout, settings, packages and logs."); }
                            }
                            Rectangle { }
                            VerticalLayout {
                                alignment: center;
                                Button {
                                    text: @tr("Open");
                                    clicked => { root.open-folder(); }
                                }
                            }
                        }
                    }
                }

                Page {
                    active: root.page == 4;
                    HorizontalLayout {
                        spacing: 8px;
                        IconButton {
                            glyph: "\u{E72B}";
                            y: 4px;
                            clicked => { root.page = 0; }
                        }
                        PageTitle { text: root.settings-title; }
                    }
                    Caption { text: root.settings-subtitle; }
                    Rectangle { height: 8px; }
                    PreviewWell {
                        height: 200px;
                        source: root.settings-preview;
                        opacity: root.settings-preview-busy ? 0.6 : 1;
                        animate opacity { duration: 180ms; }
                    }
                    Rectangle { height: 8px; }
                    for row in root.settings: VerticalLayout {
                        spacing: 4px;
                        if row.section != "": Text {
                            text: row.section;
                            font-weight: 600;
                            font-size: 14px;
                        }
                        Card {
                            height: row.error != "" ? 84px : (row.description != "" ? 68px : 52px);
                            opacity: row.enabled ? 1 : 0.5;
                            animate opacity { duration: 160ms; }
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: row.label; }
                                    if row.description != "": Caption { text: row.description; }
                                    if row.error != "": Text {
                                        text: row.error;
                                        color: #e81123;
                                        font-size: 12px;
                                    }
                                }
                                Rectangle { }
                                if row.kind == 0: Switch {
                                    enabled: row.enabled;
                                    checked: row.bool-value;
                                    toggled => { root.set-bool(row.key, self.checked); }
                                }
                                if row.kind == 1: VerticalLayout {
                                    alignment: center;
                                    SpinBox {
                                        width: 140px;
                                        enabled: row.enabled;
                                        minimum: row.min;
                                        maximum: row.max;
                                        step-size: row.step;
                                        value: row.int-value;
                                        edited(v) => { root.set-int(row.key, v); }
                                    }
                                }
                                if row.kind == 2 || row.kind == 4: VerticalLayout {
                                    alignment: center;
                                    LineEdit {
                                        width: 220px;
                                        enabled: row.enabled;
                                        text: row.text-value;
                                        input-type: row.kind == 4 ? InputType.decimal : InputType.text;
                                        edited(t) => { root.set-text(row.key, t); }
                                    }
                                }
                                if row.kind == 3: VerticalLayout {
                                    alignment: center;
                                    ComboBox {
                                        width: 220px;
                                        enabled: row.enabled;
                                        model: row.options;
                                        current-index: row.selected;
                                        selected => { root.set-choice(row.key, self.current-index); }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-top: 8px;
                        Button {
                            text: @tr("Reset to defaults");
                            clicked => { root.reset-settings(); }
                        }
                        Rectangle { }
                    }
                }

                Page {
                    active: root.page == 5;
                    HorizontalLayout {
                        spacing: 8px;
                        IconButton {
                            glyph: "\u{E72B}";
                            y: 4px;
                            clicked => { root.page = 1; }
                        }
                        PageTitle { text: root.detail.name; }
                    }
                    Caption {
                        text: root.detail.description != "" ? root.detail.description + " · " + root.detail.pack : root.detail.pack;
                    }
                    Rectangle { height: 8px; }
                    PreviewWell {
                        height: 300px;
                        source: root.detail-preview;
                        opacity: root.detail-busy ? 0.55 : 1;
                        animate opacity { duration: 180ms; }
                    }
                    Rectangle { height: 12px; }
                    Text {
                        text: @tr("Size");
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        for s[i] in root.detail-sizes: Chip {
                            text: s;
                            selected: i == root.detail-size;
                            clicked => {
                                root.detail-size = i;
                                root.choose-size(i);
                            }
                        }
                    }
                    Rectangle { height: 12px; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Button {
                            text: @tr("Add to desktop");
                            primary: true;
                            clicked => { root.add-detail(); }
                        }
                        Button {
                            text: @tr("Place it myself…");
                            clicked => { root.place-detail(); }
                        }
                    }
                }

                Page {
                    active: root.page == 6;
                    HorizontalLayout {
                        PageTitle { text: @tr("Store"); }
                        Rectangle { }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                glyph: "\u{E72C}";
                                clicked => { root.store-retry(); }
                            }
                        }
                    }
                    Caption { text: @tr("Widget packs from the Vitrine community. Each one is reviewed before it's listed."); }
                    Rectangle { height: 8px; }
                    HorizontalLayout {
                        spacing: 16px;
                        store-search := SearchBox {
                            placeholder: @tr("Search packs");
                            text <=> root.store-query;
                            edited => { root.store-filter-changed(); }
                        }
                        Caption {
                            text: root.store-count-text;
                            vertical-alignment: center;
                            wrap: no-wrap;
                            horizontal-stretch: 0;
                        }
                    }
                    Flickable {
                        height: 40px;
                        content-width: tags.preferred-width;
                        tags := HorizontalLayout {
                            spacing: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            for tag[i] in root.store-tags: PackChipView {
                                chip: tag;
                                selected: i == root.store-tag;
                                clicked => {
                                    root.store-tag = i;
                                    root.store-filter-changed();
                                }
                            }
                        }
                    }
                    if root.store-stale && root.store-state == 1: Card {
                        height: 44px;
                        background: Palette.accent-background.with-alpha(0.08);
                        border-color: Palette.accent-background.with-alpha(0.35);
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 6px;
                            spacing: 12px;
                            Glyph {
                                text: "\u{F384}";
                                width: 18px;
                            }
                            Text {
                                text: @tr("You're offline. This is the Store as it was last time.");
                                vertical-alignment: center;
                                font-size: 13px;
                                overflow: elide;
                            }
                            Rectangle { }
                            VerticalLayout {
                                alignment: center;
                                Button {
                                    text: @tr("Try again");
                                    clicked => { root.store-retry(); }
                                }
                            }
                        }
                    }
                    Rectangle { height: 6px; }
                    if root.store-state == 0: EmptyState {
                        busy: true;
                        title: @tr("Loading the Store…");
                    }
                    if root.store-state == 2: EmptyState {
                        glyph: "\u{F384}";
                        title: @tr("Can't reach the Store");
                        caption: @tr("Check your internet connection and try again.");
                        action: @tr("Try again");
                        activated => { root.store-retry(); }
                    }
                    if root.store-state == 1 && root.store-count == 0: EmptyState {
                        glyph: "\u{E721}";
                        title: @tr("No packs found");
                        caption: @tr("Try a different search, or clear the filters.");
                        action: @tr("Clear filters");
                        activated => { root.clear-store-filters(); }
                    }
                    store-grid := Rectangle {
                        property <length> gap: 14px;
                        property <int> cols: Math.max(1, Math.floor((self.width + gap) / (290px + gap)));
                        property <length> card-w: (self.width - (cols - 1) * gap) / cols;
                        property <length> card-h: card-w * 0.5 + 118px;
                        height: root.store-state == 1 ? Math.ceil(root.store-count / cols) * (card-h + gap) : 0px;
                        animate height { duration: 320ms; easing: cubic-bezier(0.1, 0.9, 0.2, 1); }
                        for item in root.store-packs: StoreCard {
                            item: item;
                            x: Math.mod(item.slot, store-grid.cols) * (store-grid.card-w + store-grid.gap);
                            y: Math.floor(item.slot / store-grid.cols) * (store-grid.card-h + store-grid.gap);
                            animate x, y { duration: 340ms; easing: cubic-bezier(0.1, 0.9, 0.2, 1); }
                            width: store-grid.card-w;
                            height: store-grid.card-h;
                            clicked => { root.store-open-pack(item.id); }
                        }
                    }
                }

                Page {
                    active: root.page == 7;
                    HorizontalLayout {
                        spacing: 8px;
                        IconButton {
                            glyph: "\u{E72B}";
                            y: 4px;
                            clicked => { root.page = 6; }
                        }
                        PageTitle {
                            text: root.store-detail.name;
                            horizontal-stretch: 0;
                        }
                        if root.store-detail.official: VerticalLayout {
                            alignment: center;
                            padding-top: 4px;
                            padding-left: 4px;
                            Pill {
                                text: @tr("Official");
                                glyph: "\u{E930}";
                                tone: 1;
                            }
                        }
                        Rectangle { }
                    }
                    Caption { text: root.store-detail-meta; }
                    Rectangle { height: 4px; }
                    if root.store-detail-description != "": Text {
                        text: root.store-detail-description;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 8px; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        if root.store-action != "": Button {
                            text: root.store-action;
                            primary: true;
                            enabled: !root.store-busy && root.store-note == "";
                            clicked => { root.store-install(); }
                        }
                        if root.store-action == "": Button {
                            text: @tr("Installed");
                            enabled: false;
                        }
                        Button {
                            text: @tr("View on GitHub");
                            clicked => { root.store-open-repo(); }
                        }
                        VerticalLayout {
                            alignment: center;
                            padding-left: 8px;
                            spacing: 4px;
                            opacity: root.store-busy ? 1 : 0;
                            animate opacity { duration: 200ms; }
                            ProgressIndicator {
                                width: 200px;
                                progress: root.store-progress;
                                indeterminate: root.store-busy && root.store-progress <= 0;
                            }
                            Caption {
                                text: root.store-progress-text;
                                wrap: no-wrap;
                            }
                        }
                    }
                    if root.store-note != "": Caption { text: root.store-note; }
                    if root.store-error != "": Text {
                        text: root.store-error;
                        color: #e81123;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 14px; }
                    SectionTitle { text: @tr("Widgets"); }
                    for w in root.store-detail-widgets: Card {
                        height: 96px;
                        HorizontalLayout {
                            padding: 8px;
                            padding-right: 14px;
                            spacing: 14px;
                            PreviewWell {
                                width: 136px;
                                source: w.preview;
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: w.name;
                                    font-weight: 600;
                                }
                                if w.description != "": Caption {
                                    text: w.description;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    padding-top: 4px;
                                    Pill {
                                        text: w.size;
                                        glyph: "\u{E740}";
                                    }
                                    if w.interactive: Pill {
                                        text: @tr("Interactive");
                                        glyph: "\u{E7C9}";
                                    }
                                    if w.online: Pill {
                                        text: @tr("Uses the internet");
                                        glyph: "\u{E774}";
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { height: 14px; }
                    SectionTitle { text: @tr("Permissions"); }
                    Caption { text: @tr("What these widgets are allowed to use. Anything not listed stays off-limits."); }
                    Card {
                        height: perms.preferred-height;
                        perms := VerticalLayout {
                            padding-top: 4px;
                            padding-bottom: 4px;
                            for p in root.store-detail-permissions: HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 14px;
                                Glyph {
                                    text: p.glyph;
                                    width: 20px;
                                    color: Palette.accent-background;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: p.title; }
                                    if p.detail != "": Caption { text: p.detail; }
                                }
                            }
                        }
                    }
                    Rectangle { height: 14px; }
                    SectionTitle { text: @tr("Details"); }
                    Card {
                        height: facts.preferred-height;
                        facts := VerticalLayout {
                            padding-top: 4px;
                            padding-bottom: 4px;
                            for f in root.store-detail-facts: HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                height: 38px;
                                spacing: 12px;
                                Text {
                                    text: f.label;
                                    vertical-alignment: center;
                                    width: 160px;
                                }
                                Caption {
                                    text: f.value;
                                    vertical-alignment: center;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// A one-line text prompt for widgets (they never get keyboard focus).
export component PromptWindow inherits Window {
    in property <string> ui-font: "Segoe UI Variable Text";
    default-font-family: root.ui-font;
    in property <string> heading: @tr("Add item");
    in property <string> placeholder;
    in property <string> initial;
    callback accepted(string);
    callback cancelled();
    title: root.heading;
    always-on-top: true;
    preferred-width: 400px;
    forward-focus: input;

    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            Text {
                text: root.heading;
                font-size: 20px;
                font-weight: 600;
                color: Palette.foreground;
            }
            input := LineEdit {
                placeholder-text: root.placeholder;
                text: root.initial;
                accepted(t) => { root.accepted(t); }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button {
                    text: @tr("Cancel");
                    clicked => { root.cancelled(); }
                }
                Button {
                    text: @tr("Save");
                    primary: true;
                    clicked => { root.accepted(input.text); }
                }
            }
        }
    }
}
